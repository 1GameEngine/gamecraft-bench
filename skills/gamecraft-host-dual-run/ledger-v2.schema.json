{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gamecraft-host-dual-run/ledger-v2.schema.json",
  "title": "Engine-toolchain effect ledger record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "claim_class",
    "slug",
    "probe_schema_version",
    "prereg_frozen_at",
    "cells"
  ],
  "properties": {
    "experiment_id": {
      "type": "string",
      "pattern": "^h-[0-9]{8}t[0-9]{6}z-[a-z0-9]{8}$"
    },
    "claim_class": {
      "const": "engine_toolchain_effect"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "probe_schema_version": {
      "const": 1
    },
    "prereg_frozen_at": {
      "type": "string",
      "description": "Commit or tag of the frozen pre-registration"
    },
    "user_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/cell"
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm",
        "repeat",
        "model",
        "build_ok",
        "launch_ok",
        "void"
      ],
      "properties": {
        "arm": {
          "enum": [
            "godot",
            "1game_eco",
            "1game_bare"
          ]
        },
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "build_ok": {
          "type": "boolean"
        },
        "launch_ok": {
          "type": "boolean"
        },
        "void": {
          "type": "boolean"
        },
        "void_reason": {
          "type": "string"
        },
        "reach": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "state": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "still_source": {
          "type": "string",
          "enum": [
            "x11_post_event",
            "1game_post_event_plus2"
          ]
        },
        "trace_author": {
          "const": "generator"
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "description": "Overrides the record slug for multi-slug matrix records"
        },
        "contaminated": {
          "type": "boolean",
          "description": "Generator reached the scorer, probe schemas, or Harbor tasks"
        },
        "contamination_reason": {
          "type": "string"
        }
      }
    }
  }
}
